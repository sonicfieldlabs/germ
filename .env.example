# Local server
GERMINATOR_HOST=127.0.0.1
GERMINATOR_PORT=8765
GERMINATOR_ACTIVE_PROVIDER=mock
GERMINATOR_OUTPUT_DIR=output

# Comma-separated Host header allowlist (blocks DNS-rebinding/cross-origin abuse).
# Defaults to localhost,127.0.0.1 (plus GERMINATOR_HOST and testserver for
# automated tests). Set to * to disable, or add a LAN IP/hostname when binding
# GERMINATOR_HOST=0.0.0.0.
GERMINATOR_ALLOWED_HOSTS=localhost,127.0.0.1

# Max accepted upload size in megabytes for audio import / multipart sources.
GERMINATOR_MAX_UPLOAD_MB=100

# Comma-separated roots accepted by generation/edit providers for input_audio_path.
# Uploads and generated files live under output/ by default. Add external sample
# folders here only when you intentionally want the server to read them.
GERMINATOR_ALLOWED_INPUT_ROOTS=output

# Max accepted inline image size in megabytes for image-to-audio analysis.
GERMINATOR_MAX_IMAGE_MB=8

# Optional local provider locations. Defaults point inside ./vendor.
GERMINATOR_OFFICIAL_REPO_DIR=vendor/stable-audio-3
GERMINATOR_MLX_REPO_DIR=vendor/stable-audio-3

# Comma-separated roots accepted for model-adjacent files such as LoRA checkpoints.
GERMINATOR_ALLOWED_MODEL_ROOTS=vendor/stable-audio-3,output

# Optional provider defaults
GERMINATOR_DEFAULT_MODEL=small-sfx
GERMINATOR_DEFAULT_DEVICE=auto
GERMINATOR_MLX_DECODER=same-s
GERMINATOR_PROVIDER_TIMEOUT_SECONDS=1800
GERMINATOR_JOB_WORKERS=1

# Optional Hugging Face token for gated Stable Audio 3 Python-provider weights.
# Prefer `uv run hf auth login`; set HF_TOKEN only if you need env-based auth.
HF_TOKEN=

# Future Stability API provider. Not required for local generation.
STABILITY_API_KEY=

# Dev conveniences read by the launch scripts (not by the server itself):
# GERMINATOR_RELOAD=1 makes launch_germinator.command start uvicorn with --reload.
# GERMINATOR_private-network_IP=100.x.y.z overrides auto-detection in scripts/run_private-network.sh.
