# Local server. GERM_* is preferred; GERMINATOR_* remains supported as a legacy
# fallback for old shells and launchers.
GERM_HOST=127.0.0.1
GERM_PORT=5178
GERM_ACTIVE_PROVIDER=mock
GERM_OUTPUT_DIR=output

# Comma-separated Host header allowlist (blocks DNS-rebinding/cross-origin abuse).
# Defaults to localhost,127.0.0.1 (plus GERM_HOST and testserver for
# automated tests). Set to * to disable, or add a LAN IP/hostname when binding
# GERM_HOST=0.0.0.0.
GERM_ALLOWED_HOSTS=localhost,127.0.0.1

# Max accepted upload size in megabytes for audio import / multipart sources.
GERM_MAX_UPLOAD_MB=100

# Comma-separated roots accepted by generation/edit providers for input_audio_path.
# Uploads and generated files live under output/ by default. Add external sample
# folders here only when you intentionally want the server to read them.
GERM_ALLOWED_INPUT_ROOTS=output

# Max accepted inline image size in megabytes for image-to-audio analysis.
GERM_MAX_IMAGE_MB=8

# Cloud image analysis is disabled by default. Set this to 1 only when you
# intentionally want /image-to-audio/analyze vision mode to send images to Gemini.
GERM_ENABLE_CLOUD_VISION=0
GERM_GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional local provider locations. Defaults point inside ./vendor.
GERM_OFFICIAL_REPO_DIR=vendor/stable-audio-3
GERM_MLX_REPO_DIR=vendor/stable-audio-3

# Comma-separated roots accepted for model-adjacent files such as LoRA checkpoints.
GERM_ALLOWED_MODEL_ROOTS=vendor/stable-audio-3,output

# Optional provider defaults
GERM_DEFAULT_MODEL=small-sfx
GERM_DEFAULT_DEVICE=auto
GERM_MLX_DECODER=same-s
GERM_PROVIDER_TIMEOUT_SECONDS=1800
GERM_JOB_WORKERS=1
GERM_LISTENER_MAX_AUDIO_MB=50
GERM_LISTENER_MAX_DURATION_SECONDS=600

# Optional Hugging Face token for gated Stable Audio 3 Python-provider weights.
# Prefer `uv run hf auth login`; set HF_TOKEN only if you need env-based auth.
HF_TOKEN=
HUGGINGFACE_HUB_TOKEN=

# Optional hosted Stable Audio 3 provider. Local providers do not require this key.
STABILITY_API_KEY=
GERM_STABILITY_API_URL=https://api.stability.ai
GERM_STABILITY_POLL_SECONDS=10

# Oída owns machine listening and audio understanding. Germ uses this bridge only
# when "Re-listen with Oída" is requested.
GERM_OIDA_URL=http://127.0.0.1:8765
GERM_OIDA_TIMEOUT_SECONDS=1800

# Dev conveniences read by the launch scripts (not by the server itself):
# GERM_RELOAD=1 makes launch_germ.command start uvicorn with --reload.
GERM_RELOAD=0
